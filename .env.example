# Copy this file to .env and replace the placeholders.
# .env is gitignored. Do not put a real password in this file.

MSSQL_SA_PASSWORD="replace-with-a-local-password"

# ASP.NET Core reads ConnectionStrings__DugoutIQ.
# dotnet ef reads DUGOUTIQ_SQL_CONNECTION, then ConnectionStrings__DugoutIQ.
# Quote values. An unquoted connection string contains spaces, so `source .env` splits on them.
# The password must match MSSQL_SA_PASSWORD.
ConnectionStrings__DugoutIQ="Server=localhost,1433;Database=DugoutIQ;User Id=sa;Password=replace-with-a-local-password;TrustServerCertificate=True;Encrypt=True"
DUGOUTIQ_SQL_CONNECTION="Server=localhost,1433;Database=DugoutIQ;User Id=sa;Password=replace-with-a-local-password;TrustServerCertificate=True;Encrypt=True"
